{
  "productName": "Porter",
  "version": "0.1.0",
  "identifier": "dev.porter.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Porter",
        "url": "index.html",
        "width": 360,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../install-default-browser.sh": "install-default-browser.sh",
      "icons/32x32.png": "porter-icon.png"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "porter.desktop.template"
      },
      "rpm": {
        "desktopTemplate": "porter.desktop.template"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["http", "https"]
      }
    }
  }
}
